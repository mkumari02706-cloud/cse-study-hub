<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-wrapper">
  <%- include('../partials/navbar') %>

  <main class="content-container">
    <div class="page-header" style="flex-wrap: wrap; gap: 16px;">
      <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
          <span style="font-size: 1.5rem;">🎙️</span>
          <h1 class="page-title" style="margin: 0;">Lecture Transcription & Complete Academic Pack</h1>
        </div>
        <p class="page-subtitle">
          Transcribe YouTube lectures or uploaded media for Explore & Learn roadmaps and Curriculum subjects into structured 15-dimension study packs.
        </p>
      </div>

      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <% if (selectedCategory && selectedType === 'explore') { %>
          <a href="/explore/<%= selectedCategory %>" class="btn btn-secondary">
            <span>🧭</span>
            <span>Back to Roadmap</span>
          </a>
        <% } %>
        <a href="/explore" class="btn btn-secondary">
          <span>🧭</span>
          <span>Explore Roadmaps</span>
        </a>
      </div>
    </div>

    <% if (!aiConfigured) { %>
      <div class="alert alert-warning" style="margin-bottom: 20px;">
        <span>ℹ️</span>
        <div>
          <strong>AI API Note:</strong> Gemini API key is active. Full 15-dimension academic study pack generation is powered by Gemini and intelligent heuristic analysis.
        </div>
      </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 2fr 1.05fr; gap: 24px;">

      <!-- Left Column: Workspace Steps (Category, Media Input, Transcript & 15-Section Academic Pack) -->
      <div style="display: flex; flex-direction: column; gap: 20px;">

        <!-- Step 1: Learning Category & Roadmap Topic Selection -->
        <div class="card">
          <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            <span style="background: var(--accent-light); color: var(--accent-primary); width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">1</span>
            <span>Select Learning Category & Roadmap Topic</span>
          </h2>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
            <div class="form-group">
              <label class="form-label" for="categoryTypeSelect">Category Type</label>
              <select id="categoryTypeSelect" class="form-control" onchange="handleCategoryTypeChange()">
                <option value="explore" <%= selectedType !== 'curriculum' ? 'selected' : '' %>>🧭 Explore & Learn Roadmap</option>
                <option value="curriculum" <%= selectedType === 'curriculum' ? 'selected' : '' %>>🎓 University Curriculum Subject</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="categorySelect">Domain / Subject *</label>
              <select id="categorySelect" class="form-control" onchange="handleCategoryChange()">
                <!-- Populated dynamically via JS -->
              </select>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div class="form-group">
              <label class="form-label" for="topicSelect">Roadmap Topic / Milestone *</label>
              <select id="topicSelect" class="form-control" onchange="handleTopicSelectChange()">
                <!-- Populated dynamically via JS -->
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="customTopicInput">Topic Title (Editable)</label>
              <input type="text" id="customTopicInput" class="form-control" placeholder="e.g. Optimized Multi-Stage Dockerfiles">
            </div>
          </div>
        </div>

        <!-- Step 2: Transcription Input Source (YouTube, Audio, Video, Recording) -->
        <div class="card">
          <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            <span style="background: var(--accent-light); color: var(--accent-primary); width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">2</span>
            <span>Provide Lecture Media or Link</span>
          </h2>

          <!-- Source Tabs -->
          <div class="tabs-nav" style="margin-bottom: 16px;">
            <button type="button" class="tab-btn active" id="tabSourceYoutubeBtn" onclick="switchSourceTab('youtube')">▶️ YouTube URL</button>
            <button type="button" class="tab-btn" id="tabSourceAudioBtn" onclick="switchSourceTab('audio')">🎵 Upload Audio</button>
            <button type="button" class="tab-btn" id="tabSourceVideoBtn" onclick="switchSourceTab('video')">📹 Upload Video</button>
            <button type="button" class="tab-btn" id="tabSourceManualBtn" onclick="switchSourceTab('manual')">📝 Text / Notes</button>
          </div>

          <!-- YouTube Tab -->
          <div id="sourceYoutubeTab">
            <div style="display: grid; grid-template-columns: 3fr 1fr auto; gap: 10px; align-items: end;">
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" for="youtubeUrlInput">Paste YouTube Lecture URL or Video ID *</label>
                <input type="text" id="youtubeUrlInput" class="form-control" placeholder="https://www.youtube.com/watch?v=... or https://youtu.be/...">
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" for="youtubeLangSelect">Captions Language</label>
                <select id="youtubeLangSelect" class="form-control">
                  <option value="en">English (en)</option>
                  <option value="hi">Hindi (hi)</option>
                </select>
              </div>
              <div>
                <button type="button" id="fetchYoutubeBtn" class="btn btn-primary" style="height: 42px;" onclick="fetchYouTubeTranscript()">
                  <span>🎙️ Transcribe Lecture</span>
                </button>
              </div>
            </div>

            <!-- Graceful Fallback: Quick File Upload (.TXT, .SRT, .VTT) when rate-limited or blocked -->
            <div id="ytUploadFallbackCard" class="hidden" style="margin-top: 14px; padding: 14px 18px; background: rgba(59, 130, 246, 0.05); border: 1px dashed var(--accent-primary); border-radius: var(--radius-md);">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                <div>
                  <strong style="font-size: 0.9rem; color: var(--accent-primary);">📁 Upload Transcript File (.TXT, .SRT, .VTT)</strong>
                  <p style="font-size: 0.78rem; color: var(--text-muted); margin: 2px 0 0 0;">Upload a local transcript or subtitle file to generate your complete study pack immediately without waiting for YouTube cooldown.</p>
                </div>
                <div>
                  <label for="ytFallbackFileInput" class="btn btn-secondary btn-sm" style="cursor: pointer; margin-bottom: 0;">
                    <span>📂 Select Subtitle/Text File</span>
                  </label>
                  <input type="file" id="ytFallbackFileInput" accept=".txt,.srt,.vtt,text/plain" style="display: none;" onchange="handleManualFileInput(event)">
                </div>
              </div>
            </div>
          </div>

          <!-- Audio Upload Tab -->
          <div id="sourceAudioTab" class="hidden">
            <div style="border: 2px dashed var(--border-color); border-radius: var(--radius-md); padding: 24px; text-align: center; background: var(--bg-primary);">
              <div style="font-size: 2.2rem; margin-bottom: 6px;">🎧</div>
              <p style="font-weight: 600; margin-bottom: 2px;">Upload Lecture Audio File (MP3, WAV, M4A, WEBM, OGG)</p>
              <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 12px;">Speech-to-text transcription with timestamps • Max 50MB</p>
              <input type="file" id="audioFileInput" accept="audio/*" style="margin-bottom: 12px;"><br>
              <button type="button" id="transcribeAudioBtn" class="btn btn-primary" onclick="uploadAndTranscribeMedia('audioFileInput')">
                <span>🎙️ Start Audio Speech-to-Text</span>
              </button>
            </div>
          </div>

          <!-- Video Upload Tab -->
          <div id="sourceVideoTab" class="hidden">
            <div style="border: 2px dashed var(--border-color); border-radius: var(--radius-md); padding: 24px; text-align: center; background: var(--bg-primary);">
              <div style="font-size: 2.2rem; margin-bottom: 6px;">🎥</div>
              <p style="font-weight: 600; margin-bottom: 2px;">Upload Lecture Video Recording (MP4, WEBM, MKV)</p>
              <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 12px;">Multimodal video transcription with timestamps • Max 50MB</p>
              <input type="file" id="videoFileInput" accept="video/*" style="margin-bottom: 12px;"><br>
              <button type="button" id="transcribeVideoBtn" class="btn btn-primary" onclick="uploadAndTranscribeMedia('videoFileInput')">
                <span>🎙️ Start Video Speech-to-Text</span>
              </button>
            </div>
          </div>

          <!-- Manual Text Tab -->
          <div id="sourceManualTab" class="hidden">
            <div style="border: 2px dashed var(--border-color); border-radius: var(--radius-md); padding: 16px; margin-bottom: 14px; background: var(--bg-primary); text-align: center;">
              <div style="font-size: 1.5rem; margin-bottom: 4px;">📄</div>
              <p style="font-weight: 600; margin-bottom: 2px; font-size: 0.9rem;">Upload Transcript or Subtitle File (.TXT, .SRT, .VTT)</p>
              <p style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 10px;">Select a local text or exported subtitle file to load into the workspace</p>
              <input type="file" id="manualTranscriptFileInput" accept=".txt,.srt,.vtt,text/plain" style="font-size: 0.82rem;" onchange="handleManualFileInput(event)">
            </div>

            <div class="form-group">
              <label class="form-label" for="manualTranscriptInput">Or Paste Lecture Transcript / Speaker Notes</label>
              <textarea id="manualTranscriptInput" class="form-control" rows="6" placeholder="Paste transcript with or without timestamps [mm:ss]..."></textarea>
            </div>
            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
              <button type="button" class="btn btn-primary btn-sm" onclick="useManualTranscript()">
                <span>✨ Use Transcript & Auto-Generate Complete Academic Pack</span>
              </button>
            </div>
          </div>

          <!-- Live Status Notification Box -->
          <div id="transcribeStatusBox" class="alert alert-info hidden" style="margin-top: 14px;"></div>
        </div>

        <!-- Step 3: Transcript Display & Live Editing -->
        <div id="transcriptViewCard" class="card hidden">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 8px;">
              <span style="background: var(--accent-light); color: var(--accent-primary); width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">3</span>
              <span>Timestamp-Wise Lecture Transcript</span>
            </h2>
            <span id="transcriptWordCount" style="font-size: 0.8rem; color: var(--text-muted);"></span>
          </div>

          <textarea id="transcriptTextarea" class="form-control" rows="8" style="font-family: monospace; font-size: 0.86rem; line-height: 1.5;"></textarea>

          <div style="margin-top: 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <button type="button" class="btn btn-secondary" onclick="discardTranscriptWorkspace()">
              <span>Cancel / Discard</span>
            </button>
            <button type="button" id="generateStudyPackBtn" class="btn btn-primary" onclick="generateCompleteStudyPack()">
              <span>✨ Re-generate 15-Section Academic Pack</span>
            </button>
          </div>
        </div>

        <!-- Step 4: Complete Academic Study Pack (All 15 Dimensions) -->
        <div id="studyPackCard" class="card hidden" style="scroll-margin-top: 80px;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 14px;">
            <div>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                <span class="core-badge" style="background: #10b98120; color: #10b981; font-weight: 700;">15 SECTIONS POPULATED</span>
                <span id="packTopicBadge" class="unit-number-badge">Topic</span>
              </div>
              <h2 style="font-size: 1.35rem; font-weight: 800; margin: 0; color: var(--accent-primary);">
                📚 Complete Academic Study Pack
              </h2>
            </div>

            <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
              <button type="button" class="btn btn-secondary btn-sm" onclick="exportPackMarkdown()" title="Export notes as Markdown file">
                <span>📥 Export Markdown</span>
              </button>
              <button type="button" class="btn btn-secondary btn-sm" onclick="copyPackMarkdown()" title="Copy notes to clipboard">
                <span>📋 Copy Notes</span>
              </button>
              <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()" title="Print Study Pack">
                <span>🖨️ Print</span>
              </button>
              <button type="button" class="btn btn-primary" id="saveStudyPackBtn" onclick="saveTranscriptAndStudyPack()">
                <span>💾 Save & Update Progress</span>
              </button>
            </div>
          </div>

          <!-- Section Jump Dropdown (Mobile / Quick Navigation) -->
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px; background: var(--bg-primary); padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
            <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-secondary); white-space: nowrap;">⚡ Jump to Section:</span>
            <select id="sectionJumpSelect" class="form-control" style="font-size: 0.85rem; padding: 4px 8px; height: auto;" onchange="switchPackTab(this.value)">
              <option value="summary">1. Lecture Summary</option>
              <option value="topicNotes">2. Topic-wise Notes</option>
              <option value="subtopics">3. Subtopic-wise Notes</option>
              <option value="detailedNotes">4. Detailed Topic Explanations</option>
              <option value="definitions">5. Important Definitions</option>
              <option value="concepts">6. Key Concepts</option>
              <option value="points">7. Important Points</option>
              <option value="realWorld">8. Real-world Examples</option>
              <option value="solvedExamples">9. Solved Examples</option>
              <option value="formulas">10. Important Formulas</option>
              <option value="flashcards">11. Active Flashcards</option>
              <option value="mcqs">12. Practice MCQs with 4 Options</option>
              <option value="mcqAnswers">13. MCQ Correct Answers</option>
              <option value="mcqExplanations">14. MCQ Explanations</option>
              <option value="shortAnswers">15. Short Answer Questions</option>
              <option value="longAnswers">16. Long Answer Questions</option>
              <option value="interviews">17. Interview Questions</option>
              <option value="viva">18. Viva Questions</option>
              <option value="pyqs">19. Previous Year Questions</option>
              <option value="pyqMapping">20. PYQ Topic Mapping</option>
              <option value="faqs">21. Frequently Asked Questions</option>
              <option value="examNotes">22. Exam-Oriented Notes</option>
              <option value="revision">23. Quick Revision Notes</option>
              <option value="practiceTests">24. Practice Tests</option>
            </select>
          </div>

          <!-- 15 Dimension Tabs Navigation -->
          <div class="tabs-nav" id="academicPackTabsNav" style="flex-wrap: wrap; gap: 6px; margin-bottom: 20px;">
            <button type="button" class="tab-btn active" data-tab="summary" onclick="switchPackTab('summary')">📝 Summary</button>
            <button type="button" class="tab-btn" data-tab="topicNotes" onclick="switchPackTab('topicNotes')">🗂️ Topic Notes <span class="badge" id="badgeTopicNotes">0</span></button>
            <button type="button" class="tab-btn" data-tab="subtopics" onclick="switchPackTab('subtopics')">📑 Subtopics <span class="badge" id="badgeSubtopics">0</span></button>
            <button type="button" class="tab-btn" data-tab="detailedNotes" onclick="switchPackTab('detailedNotes')">📖 Detailed <span class="badge" id="badgeDetailedNotes">0</span></button>
            <button type="button" class="tab-btn" data-tab="definitions" onclick="switchPackTab('definitions')">📌 Definitions <span class="badge" id="badgeDefinitions">0</span></button>
            <button type="button" class="tab-btn" data-tab="concepts" onclick="switchPackTab('concepts')">💡 Concepts <span class="badge" id="badgeConcepts">0</span></button>
            <button type="button" class="tab-btn" data-tab="points" onclick="switchPackTab('points')">⭐ Points</button>
            <button type="button" class="tab-btn" data-tab="realWorld" onclick="switchPackTab('realWorld')">🌐 Real-World <span class="badge" id="badgeRealWorld">0</span></button>
            <button type="button" class="tab-btn" data-tab="solvedExamples" onclick="switchPackTab('solvedExamples')">💻 Solved Ex <span class="badge" id="badgeSolvedExamples">0</span></button>
            <button type="button" class="tab-btn" data-tab="formulas" onclick="switchPackTab('formulas')">🧮 Formulas</button>
            <button type="button" class="tab-btn" data-tab="flashcards" onclick="switchPackTab('flashcards')">🃏 Flashcards <span class="badge" id="badgeFlashcards">0</span></button>
            <button type="button" class="tab-btn" data-tab="mcqs" onclick="switchPackTab('mcqs')">🎯 MCQs <span class="badge" id="badgeMcqs">0</span></button>
            <button type="button" class="tab-btn" data-tab="mcqAnswers" onclick="switchPackTab('mcqAnswers')">✅ Answers</button>
            <button type="button" class="tab-btn" data-tab="mcqExplanations" onclick="switchPackTab('mcqExplanations')">🔍 Explanations</button>
            <button type="button" class="tab-btn" data-tab="shortAnswers" onclick="switchPackTab('shortAnswers')">✏️ Short Qs <span class="badge" id="badgeShortAnswers">0</span></button>
            <button type="button" class="tab-btn" data-tab="longAnswers" onclick="switchPackTab('longAnswers')">📄 Long Qs <span class="badge" id="badgeLongAnswers">0</span></button>
            <button type="button" class="tab-btn" data-tab="interviews" onclick="switchPackTab('interviews')">💼 Interviews <span class="badge" id="badgeInterviews">0</span></button>
            <button type="button" class="tab-btn" data-tab="viva" onclick="switchPackTab('viva')">🎓 Viva <span class="badge" id="badgeViva">0</span></button>
            <button type="button" class="tab-btn" data-tab="pyqs" onclick="switchPackTab('pyqs')">📜 PYQs <span class="badge" id="badgePyqs">0</span></button>
            <button type="button" class="tab-btn" data-tab="pyqMapping" onclick="switchPackTab('pyqMapping')">🎯 PYQ Map</button>
            <button type="button" class="tab-btn" data-tab="faqs" onclick="switchPackTab('faqs')">💬 FAQs <span class="badge" id="badgeFaqs">0</span></button>
            <button type="button" class="tab-btn" data-tab="examNotes" onclick="switchPackTab('examNotes')">🏆 Exam Notes</button>
            <button type="button" class="tab-btn" data-tab="revision" onclick="switchPackTab('revision')">⚡ Quick Revision</button>
            <button type="button" class="tab-btn" data-tab="practiceTests" onclick="switchPackTab('practiceTests')">📝 Tests <span class="badge" id="badgePracticeTests">0</span></button>
          </div>

          <!-- Tab Panes Container -->
          <div id="academicPackPanes">
            <!-- 1. Lecture Summary -->
            <div id="packSummary" class="tab-pane active"></div>

            <!-- 2. Topic-wise Notes (Requirement 4) -->
            <div id="packTopicNotes" class="tab-pane hidden"></div>

            <!-- 3. Subtopic-wise Notes -->
            <div id="packSubtopics" class="tab-pane hidden"></div>

            <!-- 4. Detailed Explanations -->
            <div id="packDetailedNotes" class="tab-pane hidden"></div>

            <!-- 5. Important Definitions -->
            <div id="packDefinitions" class="tab-pane hidden"></div>

            <!-- 6. Key Concepts -->
            <div id="packConcepts" class="tab-pane hidden"></div>

            <!-- 7. Important Points -->
            <div id="packPoints" class="tab-pane hidden"></div>

            <!-- 8. Real-world Examples -->
            <div id="packRealWorld" class="tab-pane hidden"></div>

            <!-- 9. Solved Examples -->
            <div id="packSolvedExamples" class="tab-pane hidden"></div>

            <!-- 10. Formulas -->
            <div id="packFormulas" class="tab-pane hidden"></div>

            <!-- 11. Active Recall Flashcards -->
            <div id="packFlashcards" class="tab-pane hidden"></div>

            <!-- 12. Practice MCQs with 4 Options -->
            <div id="packMcqs" class="tab-pane hidden"></div>

            <!-- 13. MCQ Answers -->
            <div id="packMcqAnswers" class="tab-pane hidden"></div>

            <!-- 14. MCQ Explanations -->
            <div id="packMcqExplanations" class="tab-pane hidden"></div>

            <!-- 15. Short Answer Questions -->
            <div id="packShortAnswers" class="tab-pane hidden"></div>

            <!-- 16. Long Answer Questions -->
            <div id="packLongAnswers" class="tab-pane hidden"></div>

            <!-- 17. Interview Questions -->
            <div id="packInterviews" class="tab-pane hidden"></div>

            <!-- 18. Viva Questions -->
            <div id="packViva" class="tab-pane hidden"></div>

            <!-- 19. Previous Year Questions -->
            <div id="packPyqs" class="tab-pane hidden"></div>

            <!-- 20. PYQ Topic Mapping -->
            <div id="packPyqMapping" class="tab-pane hidden"></div>

            <!-- 21. FAQs -->
            <div id="packFaqs" class="tab-pane hidden"></div>

            <!-- 22. Exam-Oriented Notes -->
            <div id="packExamNotes" class="tab-pane hidden"></div>

            <!-- 23. Quick Revision Notes -->
            <div id="packRevision" class="tab-pane hidden"></div>

            <!-- 24. Practice Tests -->
            <div id="packPracticeTests" class="tab-pane hidden"></div>
          </div>
        </div>

      </div>

      <!-- Right Column: Lecture History & Transcript Search -->
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <div class="card">
          <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
            <span>📜</span>
            <span>Lecture History & Search</span>
          </h3>

          <div class="form-group" style="margin-bottom: 12px;">
            <input type="text" id="historySearchInput" class="form-control" placeholder="Search saved transcripts..." oninput="filterHistory()">
          </div>

          <div id="historyListContainer" style="display: flex; flex-direction: column; gap: 10px; max-height: 540px; overflow-y: auto;">
            <% if (history.length === 0) { %>
              <p style="text-align: center; color: var(--text-muted); font-size: 0.85rem; padding: 20px 0;">No lectures transcribed yet.</p>
            <% } else { %>
              <% history.forEach(item => { %>
                <div class="history-card" style="padding: 10px 12px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 6px;">
                    <div>
                      <span class="unit-number-badge" style="font-size: 0.68rem;"><%= item.categoryName || item.categoryId %></span>
                      <h5 style="margin: 3px 0 2px; font-size: 0.88rem; font-weight: 700;">
                        <a href="/transcription/<%= item._id %>" style="color: inherit; text-decoration: none;"><%= item.title %></a>
                      </h5>
                      <span style="font-size: 0.75rem; color: var(--text-muted);"><%= item.wordCount %> words • <%= item.sourceType %></span>
                    </div>
                    <button type="button" class="btn btn-danger-outline btn-sm" onclick="deleteHistoryItem('<%= item._id %>', '<%= (item.title || '').replace(/'/g, "\\'") %>')" style="padding: 2px 6px; font-size: 0.75rem;" title="Delete Transcript">🗑️</button>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<script>
  window.EXPLORE_TRACKS = <%- JSON.stringify(exploreTracks) %>;
  window.CURRICULUM_SUBJECTS = <%- JSON.stringify(curriculumSubjects) %>;
  window.PRESELECTED_CAT = <%- JSON.stringify(selectedCategory || '') %>;
  window.PRESELECTED_TOPIC = <%- JSON.stringify(selectedTopic || '') %>;
  window.PRESELECTED_TOPIC_ID = <%- JSON.stringify(selectedTopicId || '') %>;
  window.PRESELECTED_TYPE = <%- JSON.stringify(selectedType || 'explore') %>;
</script>
<script src="/js/transcription.js"></script>

<%- include('../partials/footer') %>