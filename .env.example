# Server Configuration
PORT=3000
NODE_ENV=production

# AI Provider Configuration
# Set your Google Gemini API Key to enable AI study material generation:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Fallback: OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: YouTube Data API v3 Key (for enhanced metadata and alternative caption querying)
YOUTUBE_API_KEY=

# Optional: External Database Connection (if configuring external MongoDB Atlas)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/csestudyhub?retryWrites=true&w=majority
