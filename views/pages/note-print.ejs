<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= lecture.topicTitle %> - Exam Printout</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background: #fff !important; color: #000 !important; padding: 24px; }
    .print-header { border-bottom: 2px solid #000; padding-bottom: 16px; margin-bottom: 24px; }
    .print-section { margin-bottom: 32px; page-break-inside: avoid; }
    h1 { font-size: 1.8rem; margin-bottom: 6px; }
    h2 { font-size: 1.3rem; border-bottom: 1px solid #ccc; padding-bottom: 4px; margin-bottom: 12px; }
    .meta-row { display: flex; justify-content: space-between; font-size: 0.9rem; color: #555; }
  </style>
</head>
<body>
  <div class="print-header">
    <h1><%= lecture.topicTitle %></h1>
    <div class="meta-row">
      <span><strong>Subject:</strong> <%= lecture.subjectName %> (Unit <%= lecture.unitNumber %>)</span>
      <span><strong>Date:</strong> <%= new Date().toLocaleDateString() %></span>
    </div>
  </div>

  <div class="print-section">
    <h2>📖 Formal University Exam Notes</h2>
    <div class="markdown-body">
      <%- (lecture.materials && lecture.materials.examNotes) ? lecture.materials.examNotes.replace(/\n/g, '<br>') : '*N/A*' %>
    </div>
  </div>

  <div class="print-section">
    <h2>⚡ Quick Revision & Formulas</h2>
    <div class="markdown-body">
      <%- (lecture.materials && lecture.materials.quickRevision) ? lecture.materials.quickRevision.replace(/\n/g, '<br>') : '*N/A*' %>
    </div>
  </div>

  <div class="print-section">
    <h2>❓ High Frequency Questions</h2>
    <div class="markdown-body">
      <%- (lecture.materials && lecture.materials.importantQuestions) ? lecture.materials.importantQuestions.replace(/\n/g, '<br>') : '*N/A*' %>
    </div>
  </div>

  <% if (lecture.materials && lecture.materials.codeExamples) { %>
    <div class="print-section">
      <h2>💻 Code Implementation & Dry Run</h2>
      <div class="markdown-body">
        <%- lecture.materials.codeExamples.replace(/\n/g, '<br>') %>
      </div>
    </div>
  <% } %>

  <script>
    window.addEventListener('load', () => {
      window.print();
    });
  </script>
</body>
</html>
