<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-wrapper">
  <%- include('../partials/navbar') %>

  <main class="content-container">
    <div class="page-header" style="flex-wrap: wrap; gap: 16px;">
      <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap;">
          <% if (transcript.categoryType === 'explore') { %>
            <a href="/explore/<%= transcript.categoryId %>" class="btn btn-secondary btn-sm">
              ← Back to <%= transcript.categoryName || 'Roadmap' %>
            </a>
          <% } else if (transcript.categoryId) { %>
            <a href="/subject/<%= transcript.categoryId %>" class="btn btn-secondary btn-sm">
              ← Back to <%= transcript.categoryName || 'Subject' %>
            </a>
          <% } %>
          <a href="/transcription" class="btn btn-secondary btn-sm">← Workspace</a>
          <span class="core-badge" style="background: var(--accent-light); color: var(--accent-primary);"><%= transcript.categoryName || transcript.categoryId %></span>
          <span class="nav-badge"><%= transcript.sourceType %></span>
          <span class="unit-number-badge" style="background: #10b98120; color: #10b981; font-weight: 700;">24 ACADEMIC DIMENSIONS ACTIVE</span>
        </div>
        <h1 class="page-title" style="margin: 0;"><%= transcript.title %></h1>
        <p class="page-subtitle" style="margin-top: 4px;">
          Milestone: <strong><%= transcript.topicTitle %></strong> • Word Count: <strong><%= transcript.wordCount %></strong> words
        </p>
      </div>

      <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
        <button type="button" class="btn btn-secondary btn-sm" onclick="exportDetailMarkdown()" title="Export notes as Markdown file">
          <span>📥 Export Markdown</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="copyDetailMarkdown()" title="Copy study notes to clipboard">
          <span>📋 Copy Notes</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()" title="Print Study Notes">
          <span>🖨️ Print</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="openRenameModal()">
          <span>✏️ Edit Title</span>
        </button>
        <button type="button" class="btn btn-danger-outline btn-sm" onclick="deleteTranscriptFromDetail('<%= transcript._id %>')">
          <span>🗑️ Delete</span>
        </button>
      </div>
    </div>

    <!-- 2 Columns: Left (Complete 24-Section Academic Pack), Right (Timestamp Transcript) -->
    <div style="display: grid; grid-template-columns: 1.6fr 1fr; gap: 24px;">

      <!-- Left Column: Complete 24-Section Academic Study Pack -->
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <div class="card" style="border-top: 4px solid var(--accent-primary);">

          <!-- Section Jump Dropdown & Section Regeneration Button -->
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; background: var(--bg-primary); padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 260px;">
              <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-secondary); white-space: nowrap;">⚡ Jump to Section:</span>
              <select id="detailSectionJumpSelect" class="form-control" style="font-size: 0.85rem; padding: 4px 8px; height: auto;" onchange="switchDetailTab(this.value)">
                <option value="summary">1. Lecture Summary</option>
                <option value="topicNotes">2. Topic-wise Notes</option>
                <option value="subtopics">3. Subtopic-wise Notes</option>
                <option value="detailedNotes">4. Detailed Topic Explanations</option>
                <option value="definitions">5. Important Definitions</option>
                <option value="concepts">6. Key Concepts</option>
                <option value="points">7. Important Points</option>
                <option value="realWorld">8. Real-world Examples</option>
                <option value="solvedExamples">9. Solved Examples</option>
                <option value="formulas">10. Important Formulas</option>
                <option value="flashcards">11. Flashcards</option>
                <option value="mcqs">12. MCQs with 4 Options</option>
                <option value="mcqAnswers">13. MCQ Correct Answers</option>
                <option value="mcqExplanations">14. MCQ Explanations</option>
                <option value="shortAnswers">15. Short Answer Questions</option>
                <option value="longAnswers">16. Long Answer Questions</option>
                <option value="interviews">17. Interview Questions</option>
                <option value="viva">18. Viva Questions</option>
                <option value="pyqs">19. Previous Year Questions</option>
                <option value="pyqMapping">20. PYQ Topic Mapping</option>
                <option value="faqs">21. Frequently Asked Questions</option>
                <option value="examNotes">22. Exam-Oriented Notes</option>
                <option value="revision">23. Quick Revision Notes</option>
                <option value="practiceTests">24. Practice Tests</option>
              </select>
            </div>
            <button type="button" class="btn btn-secondary btn-sm" id="regenDetailSectionBtn" onclick="regenerateCurrentDetailSection()" title="Regenerate this section with Gemini AI">
              <span>🔄 Regenerate Section</span>
            </button>
          </div>

          <!-- 24 Dimension Tabs -->
          <div class="tabs-nav" id="detailTabsNav" style="flex-wrap: wrap; gap: 6px; margin-bottom: 20px;">
            <button type="button" class="tab-btn active" data-tab="summary" onclick="switchDetailTab('summary')">📝 Summary</button>
            <button type="button" class="tab-btn" data-tab="topicNotes" onclick="switchDetailTab('topicNotes')">🗂️ Topic Notes <span class="badge"><%= (notes.topicWiseNotes || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="subtopics" onclick="switchDetailTab('subtopics')">📑 Subtopics <span class="badge"><%= (notes.subtopicWiseNotes || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="detailedNotes" onclick="switchDetailTab('detailedNotes')">📖 Detailed <span class="badge"><%= (notes.detailedExplanations || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="definitions" onclick="switchDetailTab('definitions')">📌 Definitions <span class="badge"><%= (notes.importantDefinitions || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="concepts" onclick="switchDetailTab('concepts')">💡 Concepts <span class="badge"><%= (notes.keyConcepts || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="points" onclick="switchDetailTab('points')">⭐ Points</button>
            <button type="button" class="tab-btn" data-tab="realWorld" onclick="switchDetailTab('realWorld')">🌐 Real-World <span class="badge"><%= (notes.realWorldExamples || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="solvedExamples" onclick="switchDetailTab('solvedExamples')">💻 Solved Ex <span class="badge"><%= (notes.solvedExamples || notes.examples || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="formulas" onclick="switchDetailTab('formulas')">🧮 Formulas</button>
            <button type="button" class="tab-btn" data-tab="flashcards" onclick="switchDetailTab('flashcards')">🃏 Flashcards <span class="badge"><%= (notes.flashcards || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="mcqs" onclick="switchDetailTab('mcqs')">🎯 MCQs <span class="badge"><%= (notes.practiceMcqs || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="mcqAnswers" onclick="switchDetailTab('mcqAnswers')">✅ Answers</button>
            <button type="button" class="tab-btn" data-tab="mcqExplanations" onclick="switchDetailTab('mcqExplanations')">🔍 Explanations</button>
            <button type="button" class="tab-btn" data-tab="shortAnswers" onclick="switchDetailTab('shortAnswers')">✏️ Short Qs <span class="badge"><%= (notes.shortAnswerQuestions || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="longAnswers" onclick="switchDetailTab('longAnswers')">📄 Long Qs <span class="badge"><%= (notes.longAnswerQuestions || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="interviews" onclick="switchDetailTab('interviews')">💼 Interviews <span class="badge"><%= (notes.interviewQuestions || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="viva" onclick="switchDetailTab('viva')">🎓 Viva <span class="badge"><%= (notes.vivaQuestions || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="pyqs" onclick="switchDetailTab('pyqs')">📜 PYQs <span class="badge"><%= (notes.previousYearQuestions || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="pyqMapping" onclick="switchDetailTab('pyqMapping')">🎯 PYQ Map</button>
            <button type="button" class="tab-btn" data-tab="faqs" onclick="switchDetailTab('faqs')">💬 FAQs <span class="badge"><%= (notes.faqs || []).length %></span></button>
            <button type="button" class="tab-btn" data-tab="examNotes" onclick="switchDetailTab('examNotes')">🏆 Exam Notes</button>
            <button type="button" class="tab-btn" data-tab="revision" onclick="switchDetailTab('revision')">⚡ Quick Revision</button>
            <button type="button" class="tab-btn" data-tab="practiceTests" onclick="switchDetailTab('practiceTests')">📝 Tests <span class="badge"><%= (notes.practiceTests || []).length %></span></button>
          </div>

          <!-- Panes Container -->
          <div id="detailPanes">

            <!-- 1. Lecture Summary -->
            <div id="detailPaneSummary" class="tab-pane active">
              <div style="padding: 16px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color); margin-bottom: 16px;">
                <h4 style="margin: 0 0 8px; font-weight: 700; color: var(--accent-primary);">📝 Complete Lecture Summary</h4>
                <p style="margin: 0; line-height: 1.6; color: var(--text-primary); font-size: 0.95rem;">
                  <%= notes.lectureSummary || notes.shortSummary || 'Comprehensive academic lecture overview synthesized directly from the verbatim transcript.' %>
                </p>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
                <div style="padding: 12px; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 6px;">
                  <strong style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Topics & Subtopics</strong>
                  <div style="font-size: 1.3rem; font-weight: 800; color: var(--accent-primary); margin-top: 4px;">
                    <%= (notes.topicWiseNotes || []).length %> / <%= (notes.subtopicWiseNotes || []).length %>
                  </div>
                </div>
                <div style="padding: 12px; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 6px;">
                  <strong style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Active Flashcards</strong>
                  <div style="font-size: 1.3rem; font-weight: 800; color: #8b5cf6; margin-top: 4px;">
                    <%= (notes.flashcards || []).length %> Cards
                  </div>
                </div>
                <div style="padding: 12px; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 6px;">
                  <strong style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Practice MCQs</strong>
                  <div style="font-size: 1.3rem; font-weight: 800; color: #10b981; margin-top: 4px;">
                    <%= (notes.practiceMcqs || []).length %> Questions
                  </div>
                </div>
                <div style="padding: 12px; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 6px;">
                  <strong style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Q&A Bank & Tests</strong>
                  <div style="font-size: 1.3rem; font-weight: 800; color: #f59e0b; margin-top: 4px;">
                    <%= (notes.shortAnswerQuestions || []).length + (notes.longAnswerQuestions || []).length + (notes.interviewQuestions || []).length %> Items
                  </div>
                </div>
              </div>
            </div>

            <!-- 2. Topic-wise Notes (Requirement 4: Intro, definition, explanation, points, examples, related Qs, timestamp) -->
            <div id="detailPaneTopicNotes" class="tab-pane hidden">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <span style="font-size: 0.85rem; color: var(--text-muted);">Expand individual topics to review introduction, formal definitions, detailed explanations, and practical examples.</span>
                <div style="display: flex; gap: 8px;">
                  <button type="button" class="btn btn-secondary btn-sm" onclick="expandAllDetailTopics(true)" style="font-size: 0.75rem; padding: 3px 8px;">➕ Expand All</button>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="expandAllDetailTopics(false)" style="font-size: 0.75rem; padding: 3px 8px;">➖ Collapse All</button>
                </div>
              </div>

              <% (notes.topicWiseNotes || []).forEach((tp, idx) => { %>
                <div class="topic-note-card" style="margin-bottom: 14px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background: var(--bg-primary);">
                  <div class="topic-header" onclick="toggleDetailTopic('<%= tp.id || 'dtp_' + idx %>')" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; cursor: pointer; user-select: none; background: var(--bg-surface); border-bottom: 1px solid var(--border-color);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                      <span id="chevron_detail_<%= tp.id || 'dtp_' + idx %>" style="font-size: 0.8rem; color: var(--text-muted); transition: transform 0.2s;">▼</span>
                      <strong style="font-size: 0.96rem;"><%= tp.title %></strong>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                      <% if (tp.timestamp) { %>
                        <span class="unit-number-badge" style="font-size: 0.72rem; cursor: pointer;" title="Jump to timestamp in transcript" onclick="event.stopPropagation(); jumpToDetailTimestamp('<%= tp.timestamp %>')">⏱️ <%= tp.timestamp %></span>
                      <% } %>
                      <span style="font-size: 0.72rem; color: var(--text-muted);"><%= (tp.subtopics || []).length %> Subtopics</span>
                    </div>
                  </div>

                  <div id="detail_topic_body_<%= tp.id || 'dtp_' + idx %>" class="detail-topic-body" style="padding: 16px;">
                    <% if (tp.subtopics && tp.subtopics.length > 0) { %>
                      <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px;">
                        <% tp.subtopics.forEach(st => { %>
                          <span style="font-size: 0.75rem; padding: 2px 8px; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; color: var(--text-secondary);">📌 <%= st %></span>
                        <% }) %>
                      </div>
                    <% } %>

                    <!-- Introduction -->
                    <% if (tp.introduction) { %>
                      <div style="margin-bottom: 12px; padding: 10px 14px; background: var(--bg-surface); border-radius: 6px;">
                        <strong style="font-size: 0.82rem; color: var(--text-muted); text-transform: uppercase;">Introduction:</strong>
                        <p style="margin: 4px 0 0; font-size: 0.88rem; line-height: 1.5; color: var(--text-primary);"><%= tp.introduction %></p>
                      </div>
                    <% } %>

                    <!-- Formal Definition -->
                    <% if (tp.definition) { %>
                      <div style="margin-bottom: 12px; padding: 10px 14px; background: var(--bg-surface); border-left: 3px solid #10b981; border-radius: 4px;">
                        <strong style="font-size: 0.82rem; color: #10b981; text-transform: uppercase;">Definition:</strong>
                        <p style="margin: 4px 0 0; font-size: 0.88rem; line-height: 1.5; color: var(--text-primary);"><%= tp.definition %></p>
                      </div>
                    <% } %>

                    <!-- Detailed Explanation -->
                    <div style="margin-bottom: 14px; padding: 12px; background: var(--bg-surface); border-radius: 6px; border-left: 3px solid var(--accent-primary);">
                      <strong style="font-size: 0.85rem; color: var(--accent-primary); display: block; margin-bottom: 4px;">📖 Detailed Topic Explanation</strong>
                      <p style="margin: 0; font-size: 0.9rem; line-height: 1.55; color: var(--text-primary); white-space: pre-wrap;"><%= tp.detailedExplanation || tp.simpleExplanation %></p>
                    </div>

                    <!-- Important Points -->
                    <% if (tp.importantPoints && tp.importantPoints.length > 0) { %>
                      <div style="margin-bottom: 12px;">
                        <strong style="font-size: 0.84rem; color: var(--text-muted); text-transform: uppercase;">Important Points:</strong>
                        <ul style="margin: 6px 0 0; padding-left: 18px; font-size: 0.86rem; color: var(--text-secondary); line-height: 1.5;">
                          <% tp.importantPoints.forEach(pt => { %>
                            <li style="margin-bottom: 4px;"><%= pt %></li>
                          <% }) %>
                        </ul>
                      </div>
                    <% } %>

                    <!-- Examples -->
                    <% if (tp.examples && tp.examples.length > 0) { %>
                      <div style="margin-bottom: 12px;">
                        <strong style="font-size: 0.84rem; color: var(--text-muted); text-transform: uppercase;">Practical Examples:</strong>
                        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 6px;">
                          <% tp.examples.forEach(ex => { %>
                            <div style="font-size: 0.86rem; padding: 8px 12px; background: var(--bg-surface); border-radius: 4px; border: 1px solid var(--border-color);">
                              <strong style="color: var(--accent-primary);"><%= ex.title || 'Example' %>:</strong>
                              <span style="display: block; margin-top: 2px; color: var(--text-secondary);"><%= ex.explanation || ex.scenario || '' %></span>
                            </div>
                          <% }) %>
                        </div>
                      </div>
                    <% } %>

                    <!-- Related Questions -->
                    <% if (tp.relatedQuestions && tp.relatedQuestions.length > 0) { %>
                      <div>
                        <strong style="font-size: 0.84rem; color: var(--text-muted); text-transform: uppercase;">Related Exam Questions:</strong>
                        <ul style="margin: 6px 0 0; padding-left: 18px; font-size: 0.86rem; color: var(--text-secondary);">
                          <% tp.relatedQuestions.forEach(rq => { %>
                            <li style="margin-bottom: 3px;">❓ <%= rq %></li>
                          <% }) %>
                        </ul>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>

            <!-- 3. Subtopic-wise Notes -->
            <div id="detailPaneSubtopics" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <% (notes.subtopicWiseNotes || []).forEach(st => { %>
                  <div style="padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                      <strong style="font-size: 0.95rem; color: var(--accent-primary);"><%= st.subtopicTitle %></strong>
                      <span class="unit-number-badge" style="font-size: 0.72rem;"><%= st.timestamp || '[00:00]' %></span>
                    </div>
                    <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-bottom: 6px;">Parent: <%= st.parentTopic %></span>
                    <p style="margin: 0 0 8px; font-size: 0.88rem; line-height: 1.5; color: var(--text-secondary);"><%= st.summary %></p>
                    <% if (st.keyTakeaways && st.keyTakeaways.length > 0) { %>
                      <div style="font-size: 0.82rem; color: var(--text-muted);">
                        <strong>Key Takeaways:</strong>
                        <ul style="margin: 4px 0 0; padding-left: 18px;">
                          <% st.keyTakeaways.forEach(kt => { %>
                            <li><%= kt %></li>
                          <% }) %>
                        </ul>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 4. Detailed Topic Explanations -->
            <div id="detailPaneDetailedNotes" class="tab-pane hidden">
              <% (notes.detailedExplanations || []).forEach(n => { %>
                <div style="margin-bottom: 14px; padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <h4 style="margin: 0; font-weight: 700; font-size: 0.98rem; color: var(--accent-primary);"><%= n.heading %></h4>
                    <% if (n.timestampRef) { %>
                      <span class="unit-number-badge" style="font-size: 0.7rem; cursor: pointer;" onclick="jumpToDetailTimestamp('<%= n.timestampRef %>')"><%= n.timestampRef %></span>
                    <% } %>
                  </div>
                  <p style="margin: 0 0 8px; color: var(--text-secondary); white-space: pre-wrap; font-size: 0.88rem; line-height: 1.55;"><%= n.content %></p>
                  <% if (n.takeaway) { %>
                    <div style="font-size: 0.8rem; color: var(--text-muted); background: var(--bg-surface); padding: 4px 8px; border-radius: 4px;">💡 <strong>Takeaway:</strong> <%= n.takeaway %></div>
                  <% } %>
                </div>
              <% }) %>
            </div>

            <!-- 5. Important Definitions -->
            <div id="detailPaneDefinitions" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 10px;">
                <% (notes.importantDefinitions || []).forEach(d => { %>
                  <div style="padding: 12px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                      <strong style="font-size: 0.94rem; color: var(--accent-primary);"><%= d.term %></strong>
                      <% if (d.timestampRef) { %>
                        <span class="unit-number-badge" style="font-size: 0.7rem; cursor: pointer;" onclick="jumpToDetailTimestamp('<%= d.timestampRef %>')"><%= d.timestampRef %></span>
                      <% } %>
                    </div>
                    <p style="margin: 0 0 4px; font-size: 0.88rem; line-height: 1.45; color: var(--text-primary);"><%= d.definition %></p>
                    <% if (d.context) { %>
                      <span style="font-size: 0.76rem; color: var(--text-muted); display: block;">Context: <%= d.context %></span>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 6. Key Concepts -->
            <div id="detailPaneConcepts" class="tab-pane hidden">
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
                <% (notes.keyConcepts || []).forEach(c => { %>
                  <div style="padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color); display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <strong style="font-size: 0.92rem;"><%= c.concept || c %></strong>
                        <span class="nav-badge" style="font-size: 0.7rem;"><%= c.importance || 'High' %></span>
                      </div>
                      <p style="margin: 0; font-size: 0.86rem; line-height: 1.45; color: var(--text-secondary);"><%= c.explanation || c %></p>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 7. Important Points -->
            <div id="detailPanePoints" class="tab-pane hidden">
              <div style="padding: 16px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <h4 style="margin: 0 0 12px; font-weight: 700; color: #f59e0b;">⭐ Essential Exam & Implementation Highlights</h4>
                <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px;">
                  <% (notes.importantPoints || []).forEach(p => { %>
                    <li style="font-size: 0.88rem; line-height: 1.45; color: var(--text-primary);"><%= p %></li>
                  <% }) %>
                </ul>
              </div>
            </div>

            <!-- 8. Real-world Examples -->
            <div id="detailPaneRealWorld" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 14px;">
                <% (notes.realWorldExamples || []).forEach(rw => { %>
                  <div style="padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                      <strong style="font-size: 0.95rem; color: var(--accent-primary);"><%= rw.title %></strong>
                      <span class="unit-number-badge" style="font-size: 0.72rem;"><%= rw.industryDomain %></span>
                    </div>
                    <div style="font-size: 0.86rem; color: var(--text-secondary); margin-bottom: 6px;">
                      <strong>Scenario:</strong> <%= rw.scenario %>
                    </div>
                    <div style="font-size: 0.86rem; color: var(--text-secondary); margin-bottom: 6px;">
                      <strong>Implementation:</strong> <%= rw.implementation %>
                    </div>
                    <div style="font-size: 0.82rem; color: #10b981; background: #10b98115; padding: 4px 8px; border-radius: 4px;">
                      🚀 <strong>Impact:</strong> <%= rw.impact %>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 9. Solved Examples -->
            <div id="detailPaneSolvedExamples" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 14px;">
                <% (notes.solvedExamples || notes.examples || []).forEach((se, idx) => { %>
                  <div style="padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <strong style="font-size: 0.95rem; color: var(--accent-primary); display: block; margin-bottom: 6px;">
                      <%= se.problemTitle || se.title || ('Solved Problem ' + (idx + 1)) %>
                    </strong>
                    <p style="margin: 0 0 10px; font-size: 0.88rem; line-height: 1.5; color: var(--text-primary);">
                      <%= se.problemStatement || se.scenario || se.explanation %>
                    </p>
                    <% if (se.stepByStepSolution && se.stepByStepSolution.length > 0) { %>
                      <div style="margin-bottom: 10px;">
                        <strong style="font-size: 0.82rem; color: var(--text-muted); text-transform: uppercase;">Step-by-Step Walkthrough:</strong>
                        <ol style="margin: 4px 0 0; padding-left: 20px; font-size: 0.86rem; color: var(--text-secondary); line-height: 1.5;">
                          <% se.stepByStepSolution.forEach(st => { %>
                            <li><%= st %></li>
                          <% }) %>
                        </ol>
                      </div>
                    <% } %>
                    <% if (se.finalAnswerOrCode || se.codeOrIllustration || se.example) { %>
                      <pre style="background: var(--bg-surface); padding: 10px 12px; border-radius: 4px; font-size: 0.82rem; overflow-x: auto; margin: 0 0 6px; border: 1px solid var(--border-color);"><code><%= se.finalAnswerOrCode || se.codeOrIllustration || se.example %></code></pre>
                    <% } %>
                    <% if (se.complexityAnalysis) { %>
                      <span style="font-size: 0.78rem; color: var(--text-muted); display: block;">⚡ Complexity: <%= se.complexityAnalysis %></span>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 10. Important Formulas -->
            <div id="detailPaneFormulas" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <% (notes.formulas || []).forEach(f => { %>
                  <div style="padding: 12px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <strong style="color: var(--accent-primary); font-size: 0.92rem;"><%= f.name %></strong>
                    <div style="margin: 6px 0; padding: 6px 12px; background: var(--bg-surface); border-radius: 4px; font-family: monospace; font-size: 0.92rem; color: var(--accent-primary); font-weight: 700;">
                      <%= f.formula %>
                    </div>
                    <p style="margin: 4px 0 0; font-size: 0.85rem; color: var(--text-secondary);"><%= f.explanation %></p>
                    <% if (f.variables) { %>
                      <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-top: 4px;">Parameters: <%= f.variables %></span>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 11. Flashcards (Requirement 2: Full interactive controls, shuffle, complete, track progress) -->
            <div id="detailPaneFlashcards" class="tab-pane hidden">
              <div id="detailFlashcardContainer"></div>
            </div>

            <!-- 12. Practice MCQs (Requirement 3: Option selection, submit, instant feedback, score calculation) -->
            <div id="detailPaneMcqs" class="tab-pane hidden">
              <div id="detailMcqContainer"></div>
            </div>

            <!-- 13. MCQ Correct Answers -->
            <div id="detailPaneMcqAnswers" class="tab-pane hidden">
              <div style="padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <h4 style="margin: 0 0 12px; font-weight: 700; color: #10b981;">✅ Master Answer Key Table</h4>
                <div style="overflow-x: auto;">
                  <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                    <thead>
                      <tr style="background: var(--bg-surface); border-bottom: 2px solid var(--border-color); text-align: left;">
                        <th style="padding: 8px 10px;">#</th>
                        <th style="padding: 8px 10px;">Question</th>
                        <th style="padding: 8px 10px; width: 80px;">Option</th>
                        <th style="padding: 8px 10px;">Correct Answer Text</th>
                        <th style="padding: 8px 10px;">Key Rationale</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% (notes.mcqCorrectAnswers || []).forEach(a => { %>
                        <tr style="border-bottom: 1px solid var(--border-color);">
                          <td style="padding: 8px 10px; font-weight: 700;"><%= a.questionNumber %></td>
                          <td style="padding: 8px 10px;"><%= a.question %></td>
                          <td style="padding: 8px 10px; font-weight: 800; color: #10b981;"><%= a.correctOptionLetter %></td>
                          <td style="padding: 8px 10px;"><%= a.correctOptionText %></td>
                          <td style="padding: 8px 10px; color: var(--text-secondary);"><%= a.keyRationale %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- 14. MCQ Explanations -->
            <div id="detailPaneMcqExplanations" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <% (notes.mcqExplanations || []).forEach(e => { %>
                  <div style="padding: 12px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <strong style="font-size: 0.9rem; color: var(--accent-primary); display: block; margin-bottom: 6px;">
                      Q<%= e.questionNumber %>: <%= e.question %>
                    </strong>
                    <div style="font-size: 0.86rem; color: var(--text-primary); margin-bottom: 6px; padding: 6px 10px; background: var(--bg-surface); border-left: 3px solid #10b981; border-radius: 4px;">
                      <strong>Correct Rationale:</strong> <%= e.correctExplanation %>
                    </div>
                    <div style="font-size: 0.82rem; color: var(--text-muted);">
                      <strong>Distractor Analysis:</strong> <%= e.distractorAnalysis %>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 15. Short Answer Questions -->
            <div id="detailPaneShortAnswers" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <% (notes.shortAnswerQuestions || []).forEach((q, idx) => { %>
                  <div style="padding: 12px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                      <strong style="font-size: 0.92rem;">Q<%= idx + 1 %>: <%= q.question %></strong>
                      <span class="unit-number-badge" style="font-size: 0.72rem;"><%= q.marks || 2 %> Marks</span>
                    </div>
                    <p style="margin: 0 0 6px; font-size: 0.88rem; line-height: 1.45; color: var(--text-secondary);"><%= q.answer %></p>
                    <% if (q.keyPoints && q.keyPoints.length > 0) { %>
                      <div style="font-size: 0.78rem; color: var(--text-muted);">
                        <strong>Scoring Points:</strong> <%= q.keyPoints.join(' • ') %>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 16. Long Answer Questions -->
            <div id="detailPaneLongAnswers" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 14px;">
                <% (notes.longAnswerQuestions || []).forEach((q, idx) => { %>
                  <div style="padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                      <strong style="font-size: 0.96rem; color: var(--accent-primary);">Q<%= idx + 1 %>: <%= q.question %></strong>
                      <span class="unit-number-badge" style="font-size: 0.75rem; background: #8b5cf620; color: #8b5cf6;"><%= q.marks || 7 %> Marks</span>
                    </div>
                    <p style="margin: 0 0 10px; font-size: 0.9rem; line-height: 1.55; color: var(--text-primary);"><%= q.answer %></p>
                    <% if (q.structuralOutline && q.structuralOutline.length > 0) { %>
                      <div style="padding: 8px 12px; background: var(--bg-surface); border-radius: 4px; font-size: 0.82rem; color: var(--text-muted);">
                        <strong>Model Outline for Full Marks:</strong>
                        <ul style="margin: 4px 0 0; padding-left: 18px;">
                          <% q.structuralOutline.forEach(o => { %>
                            <li><%= o %></li>
                          <% }) %>
                        </ul>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 17. Interview Questions -->
            <div id="detailPaneInterviews" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 14px;">
                <% (notes.interviewQuestions || []).forEach(iq => { %>
                  <div style="padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                      <strong style="font-size: 0.94rem;">💼 <%= iq.question %></strong>
                      <span class="unit-number-badge" style="font-size: 0.72rem;"><%= iq.companyContext %></span>
                    </div>
                    <p style="margin: 0 0 8px; font-size: 0.88rem; line-height: 1.5; color: var(--text-primary);"><%= iq.technicalAnswer %></p>
                    <% if (iq.followUpTip) { %>
                      <div style="font-size: 0.8rem; color: var(--accent-primary); background: var(--accent-light); padding: 4px 8px; border-radius: 4px;">
                        💡 <strong>Interview Pro-Tip:</strong> <%= iq.followUpTip %>
                      </div>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 18. Viva Questions -->
            <div id="detailPaneViva" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 10px;">
                <% (notes.vivaQuestions || []).forEach((vq, idx) => { %>
                  <div style="padding: 12px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <strong style="font-size: 0.9rem; display: block; margin-bottom: 4px;">🎓 Q<%= idx + 1 %>: <%= vq.question %></strong>
                    <p style="margin: 0 0 4px; font-size: 0.86rem; color: var(--text-secondary);"><%= vq.quickAnswer %></p>
                    <span style="font-size: 0.76rem; color: #10b981; font-weight: 600;">Expected Keywords: <%= vq.examinerExpectedKeyword %></span>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 19. Previous Year Questions -->
            <div id="detailPanePyqs" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <% (notes.previousYearQuestions || []).forEach(pyq => { %>
                  <div style="padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                      <span class="unit-number-badge" style="background: #f59e0b20; color: #d97706; font-size: 0.72rem;"><%= pyq.year %></span>
                      <span style="font-size: 0.75rem; color: var(--text-muted);"><%= pyq.frequency %> • [<%= pyq.marks || 7 %> Marks]</span>
                    </div>
                    <p style="margin: 0 0 8px; font-size: 0.92rem; font-weight: 600;"><%= pyq.question %></p>
                    <div style="font-size: 0.84rem; color: var(--accent-primary); background: var(--bg-surface); padding: 6px 10px; border-radius: 4px; border-left: 3px solid var(--accent-primary);">
                      💡 <strong>Model Exam Answer Strategy:</strong> <%= pyq.solution %>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 20. PYQ Topic Mapping -->
            <div id="detailPanePyqMapping" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <% (notes.pyqTopicMapping || []).forEach(pm => { %>
                  <div style="padding: 12px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                      <strong style="font-size: 0.92rem;"><%= pm.topicName %></strong>
                      <span class="unit-number-badge" style="font-size: 0.72rem;"><%= pm.appearancesCount %> Appearances</span>
                    </div>
                    <span style="font-size: 0.78rem; color: #f59e0b; font-weight: 700; display: block; margin-bottom: 4px;">Weightage: <%= pm.examWeightage %></span>
                    <p style="margin: 0; font-size: 0.85rem; color: var(--text-secondary);"><%= pm.trendAnalysis %></p>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 21. FAQs -->
            <div id="detailPaneFaqs" class="tab-pane hidden">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-size: 0.85rem; color: var(--text-muted);">Common student doubts and practical questions.</span>
                <div style="display: flex; gap: 8px;">
                  <button type="button" class="btn btn-secondary btn-sm" onclick="toggleAllDetailFaqs(true)" style="font-size: 0.75rem; padding: 3px 8px;">Expand All</button>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="toggleAllDetailFaqs(false)" style="font-size: 0.75rem; padding: 3px 8px;">Collapse All</button>
                </div>
              </div>
              <div style="display: flex; flex-direction: column; gap: 10px;">
                <% (notes.faqs || []).forEach((faq, i) => { %>
                  <div style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background: var(--bg-primary);">
                    <div onclick="toggleDetailAnswer('dfaq_ans_<%= i %>')" style="display: flex; justify-content: space-between; align-items: center; padding: 12px; cursor: pointer; background: var(--bg-surface); user-select: none;">
                      <strong style="font-size: 0.9rem;">❓ <%= faq.question %></strong>
                      <span id="chevron_dfaq_ans_<%= i %>" style="font-size: 0.8rem; color: var(--text-muted);">▼</span>
                    </div>
                    <div id="dfaq_ans_<%= i %>" class="hidden" style="padding: 12px 14px; font-size: 0.88rem; line-height: 1.5; color: var(--text-secondary); border-top: 1px solid var(--border-color);">
                      <p style="margin: 0 0 6px;"><%= faq.answer %></p>
                      <% if (faq.practicalScenario) { %>
                        <span style="font-size: 0.78rem; color: var(--accent-primary); display: block;">💡 Practical Context: <%= faq.practicalScenario %></span>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- 22. Exam-Oriented Notes -->
            <div id="detailPaneExamNotes" class="tab-pane hidden">
              <% (notes.examOrientedNotes || []).forEach(e => { %>
                <div style="margin-bottom: 12px; padding: 12px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                  <span class="core-badge" style="margin-bottom: 6px; font-size: 0.72rem;"><%= e.category %></span>
                  <p style="margin: 4px 0 6px; font-size: 0.88rem; line-height: 1.45;"><%= e.tip %></p>
                  <% if (e.commonMistakesToAvoid) { %>
                    <div style="font-size: 0.82rem; color: #dc2626; background: #fee2e220; padding: 4px 8px; border-radius: 4px;">
                      ⚠️ <strong>Common Mistake:</strong> <%= e.commonMistakesToAvoid %>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>

            <!-- 23. Quick Revision Notes -->
            <div id="detailPaneRevision" class="tab-pane hidden">
              <div style="padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                <h4 style="margin: 0 0 10px; font-weight: 700; color: #10b981;">⚡ 5-Minute Pre-Exam Cheat Sheet</h4>
                <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px;">
                  <% (notes.quickRevisionNotes || []).forEach(r => { %>
                    <li style="font-size: 0.88rem; line-height: 1.45;"><%= r %></li>
                  <% }) %>
                </ul>
              </div>
            </div>

            <!-- 24. Practice Tests -->
            <div id="detailPanePracticeTests" class="tab-pane hidden">
              <div style="display: flex; flex-direction: column; gap: 14px;">
                <% (notes.practiceTests || []).forEach(pt => { %>
                  <div style="padding: 16px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                      <h4 style="margin: 0; font-weight: 700; color: var(--accent-primary);"><%= pt.testTitle %></h4>
                      <span class="unit-number-badge" style="background: #10b98120; color: #10b981;">⏱️ <%= pt.durationMinutes %> Mins • <%= pt.totalMarks %> Marks</span>
                    </div>
                    <p style="margin: 0 0 12px; font-size: 0.84rem; color: var(--text-muted);"><%= pt.instructions %></p>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                      <% (pt.questions || []).forEach(pq => { %>
                        <div style="padding: 10px 12px; background: var(--bg-surface); border-radius: 4px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                          <div>
                            <strong style="font-size: 0.88rem;">Q<%= pq.qNum %>: <%= pq.question %></strong>
                            <span style="font-size: 0.74rem; color: var(--text-muted); display: block; margin-top: 2px;">Type: <%= pq.type %></span>
                          </div>
                          <span class="unit-number-badge" style="font-size: 0.72rem; white-space: nowrap;"><%= pq.marks %> Marks</span>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

          </div>

        </div>
      </div>

      <!-- Right Column: Full Timestamped Transcript -->
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <div class="card" style="position: sticky; top: 80px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 8px;">
              <span>⏱️</span>
              <span>Verbatim Timestamp Transcript</span>
            </h3>
            <span style="font-size: 0.75rem; color: var(--text-muted);"><%= transcript.wordCount %> words</span>
          </div>

          <div class="form-group" style="margin-bottom: 12px;">
            <input type="text" id="transcriptSearchInput" class="form-control" placeholder="Search transcript..." oninput="filterTranscriptLines()">
          </div>

          <div id="transcriptLinesContainer" style="max-height: 620px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;">
            <% if (transcript.timestampedTranscript && transcript.timestampedTranscript.length > 0) { %>
              <% transcript.timestampedTranscript.forEach((t, idx) => { %>
                <div class="transcript-line" id="line_<%= t.timestamp.replace(/[\[\]]/g, '').replace(':', '_') %>" style="padding: 8px 10px; background: var(--bg-primary); border-radius: var(--radius-sm); font-size: 0.85rem; line-height: 1.4; border-left: 3px solid transparent;">
                  <span class="unit-number-badge" style="font-size: 0.7rem; margin-right: 6px;"><%= t.timestamp %></span>
                  <span><%= t.text %></span>
                </div>
              <% }) %>
            <% } else { %>
              <div id="rawTranscriptText" style="white-space: pre-wrap; font-family: monospace; font-size: 0.84rem; line-height: 1.5; color: var(--text-secondary); padding: 8px; background: var(--bg-primary); border-radius: var(--radius-sm);">
                <%= transcript.rawText %>
              </div>
            <% } %>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Rename Modal -->
<div id="renameModal" class="modal-overlay hidden" style="position: fixed; inset: 0; background: rgba(0,0,0,0.65); display: flex; align-items: center; justify-content: center; z-index: 1000;">
  <div class="card" style="width: 100%; max-width: 500px; background: var(--bg-surface); padding: 24px;">
    <h3 style="margin-top: 0;">Edit Transcript Title</h3>
    <input type="text" id="renameTitleInput" class="form-control" value="<%= transcript.title %>" style="margin-bottom: 16px;">
    <div style="display: flex; justify-content: flex-end; gap: 10px;">
      <button type="button" class="btn btn-secondary" onclick="closeRenameModal()">Cancel</button>
      <button type="button" class="btn btn-primary" onclick="saveRename('<%= transcript._id %>')">Save</button>
    </div>
  </div>
</div>

<script>
  const STUDY_PACK_DATA = <%- JSON.stringify(notes) %>;
  const TRANSCRIPT_DATA = <%- JSON.stringify(transcript) %>;

  // Flashcards state
  let dFlashcards = (STUDY_PACK_DATA.flashcards && STUDY_PACK_DATA.flashcards.length > 0) ?
    STUDY_PACK_DATA.flashcards : [
      {
        id: 1,
        front: "What is the primary objective of " + (TRANSCRIPT_DATA.topicTitle || "this lecture") + "?",
        back: "To structure modular computation, verify defensive invariants, and ensure system determinism.",
        topic: TRANSCRIPT_DATA.topicTitle || "Core Architecture",
        difficulty: "Easy",
        difficultyLevel: "Easy",
        completed: false
      }
    ];
  let dCardIndex = 0;
  let dIsCardFlipped = false;
  let dCompletedCards = new Set();

  // MCQs state
  let dMcqs = (STUDY_PACK_DATA.practiceMcqs && STUDY_PACK_DATA.practiceMcqs.length > 0) ?
    STUDY_PACK_DATA.practiceMcqs : [
      {
        id: 1,
        question: "What is the main engineering goal of " + (TRANSCRIPT_DATA.topicTitle || "this topic") + "?",
        options: [
          "To optimize system reliability and modular determinism",
          "To bypass compilation safety invariants",
          "To exhaust available auxiliary memory buffers",
          "None of the above"
        ],
        correctOption: 0,
        explanation: "Option A is correct based on core engineering and architectural principles.",
        difficultyLevel: "Easy",
        relatedTopic: TRANSCRIPT_DATA.topicTitle || "Foundations"
      }
    ];
  let dMcqAnswers = {};

  document.addEventListener('DOMContentLoaded', () => {
    initDetailFlashcards();
    initDetailMcqs();
  });

  let currentDetailTab = 'summary';

  // Tab switching with active & hidden classes (Requirement 1 & Global Audit)
  function switchDetailTab(name) {
    currentDetailTab = name;
    const tabMap = {
      summary: 'detailPaneSummary',
      topicNotes: 'detailPaneTopicNotes',
      subtopics: 'detailPaneSubtopics',
      detailedNotes: 'detailPaneDetailedNotes',
      definitions: 'detailPaneDefinitions',
      concepts: 'detailPaneConcepts',
      points: 'detailPanePoints',
      realWorld: 'detailPaneRealWorld',
      solvedExamples: 'detailPaneSolvedExamples',
      formulas: 'detailPaneFormulas',
      flashcards: 'detailPaneFlashcards',
      mcqs: 'detailPaneMcqs',
      mcqAnswers: 'detailPaneMcqAnswers',
      mcqExplanations: 'detailPaneMcqExplanations',
      shortAnswers: 'detailPaneShortAnswers',
      longAnswers: 'detailPaneLongAnswers',
      interviews: 'detailPaneInterviews',
      viva: 'detailPaneViva',
      pyqs: 'detailPanePyqs',
      pyqMapping: 'detailPanePyqMapping',
      faqs: 'detailPaneFaqs',
      examNotes: 'detailPaneExamNotes',
      revision: 'detailPaneRevision',
      practiceTests: 'detailPanePracticeTests'
    };

    Object.keys(tabMap).forEach(k => {
      const pane = document.getElementById(tabMap[k]);
      if (pane) {
        pane.classList.toggle('active', k === name);
        pane.classList.toggle('hidden', k !== name);
      }
    });

    document.querySelectorAll('#detailTabsNav .tab-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.tab === name);
    });

    const select = document.getElementById('detailSectionJumpSelect');
    if (select) select.value = name;
  }

  async function regenerateCurrentDetailSection() {
    const btn = document.getElementById('regenDetailSectionBtn');
    if (btn) {
      btn.disabled = true;
      btn.innerText = '⏳ Regenerating with Gemini...';
    }
    try {
      const res = await fetch('/transcription/api/regenerate-section', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          transcriptId: TRANSCRIPT_DATA._id,
          sectionName: currentDetailTab
        })
      });
      const data = await res.json();
      if (data.success) {
        if (window.showToast) window.showToast(`Section "${currentDetailTab}" regenerated successfully!`, 'success');
        setTimeout(() => window.location.reload(), 600);
      } else {
        alert(data.error || 'Failed to regenerate section.');
      }
    } catch (e) {
      alert('Error regenerating section: ' + e.message);
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<span>🔄 Regenerate Section</span>';
      }
    }
  }

  // Topic expansion (Requirement 4)
  function toggleDetailTopic(id) {
    const body = document.getElementById('detail_topic_body_' + id);
    const chevron = document.getElementById('chevron_detail_' + id);
    if (body) {
      const isHidden = body.classList.toggle('hidden');
      if (chevron) chevron.textContent = isHidden ? '▶' : '▼';
    }
  }

  function expandAllDetailTopics(expand) {
    document.querySelectorAll('.detail-topic-body').forEach(b => {
      b.classList.toggle('hidden', !expand);
    });
    document.querySelectorAll('[id^="chevron_detail_"]').forEach(ch => {
      ch.textContent = expand ? '▼' : '▶';
    });
  }

  function toggleDetailAnswer(id) {
    const el = document.getElementById(id);
    const chevron = document.getElementById('chevron_' + id);
    if (el) {
      const isHidden = el.classList.toggle('hidden');
      if (chevron) chevron.textContent = isHidden ? '▼' : '▲';
    }
  }

  function toggleAllDetailFaqs(expand) {
    document.querySelectorAll('[id^="dfaq_ans_"]').forEach(el => {
      el.classList.toggle('hidden', !expand);
    });
    document.querySelectorAll('[id^="chevron_dfaq_ans_"]').forEach(ch => {
      ch.textContent = expand ? '▲' : '▼';
    });
  }

  // Flashcards (Requirement 2: Full interactive controls, flip, shuffle, complete, track progress)
  function initDetailFlashcards() {
    renderDetailFlashcardView();
  }

  function renderDetailFlashcardView() {
    const container = document.getElementById('detailFlashcardContainer');
    if (!container) return;
    if (!dFlashcards || dFlashcards.length === 0) {
      container.innerHTML = '<p>No flashcards available for this lecture.</p>';
      return;
    }

    const card = dFlashcards[dCardIndex];
    const total = dFlashcards.length;
    const isCompleted = dCompletedCards.has(dCardIndex);
    const completedCount = dCompletedCards.size;
    const progressPercent = Math.round((completedCount / total) * 100);
    const diffBadge = card.difficultyLevel || card.difficulty || 'Medium';

    container.innerHTML = `
      <div style="max-width: 640px; margin: 0 auto;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <div>
            <strong style="font-size: 0.95rem;">Card ${dCardIndex + 1} of ${total}</strong>
            <span style="font-size: 0.8rem; color: var(--text-muted); margin-left: 6px;">(${completedCount} completed • ${progressPercent}%)</span>
          </div>
          <div style="display: flex; gap: 6px; align-items: center;">
            <span class="unit-number-badge" style="font-size: 0.75rem;">${card.topic || 'Flashcard'}</span>
            <span class="nav-badge" style="font-size: 0.72rem; ${diffBadge === 'Easy' ? 'background: #10b98120; color: #10b981;' : (diffBadge === 'Hard' ? 'background: #ef444420; color: #ef4444;' : 'background: #f59e0b20; color: #f59e0b;')}">${diffBadge}</span>
          </div>
        </div>

        <div class="progress-container" style="height: 6px; margin-bottom: 16px; background: var(--bg-surface); border-radius: 4px; overflow: hidden;">
          <div class="progress-bar-fill" style="width: ${progressPercent}%; height: 100%; background: #8b5cf6; transition: width 0.3s ease;"></div>
        </div>

        <div onclick="flipDetailCard()" style="min-height: 220px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 32px 24px; cursor: pointer; user-select: none; border-radius: var(--radius-md); border: 2px solid ${isCompleted ? '#10b981' : 'var(--border-color)'}; background: var(--bg-surface); position: relative; box-shadow: var(--shadow-sm); transition: transform 0.2s ease;">
          <div style="position: absolute; top: 12px; left: 16px; font-size: 0.72rem; font-weight: 700; color: var(--accent-primary); text-transform: uppercase;">
            ${dIsCardFlipped ? 'ANSWER / BACK' : 'QUESTION / FRONT'}
          </div>

          ${isCompleted ? `
            <div style="position: absolute; top: 12px; right: 16px; font-size: 0.72rem; font-weight: 700; color: #10b981; background: #10b98120; padding: 2px 8px; border-radius: 12px;">
              ✅ Completed
            </div>
          ` : ''}

          <div style="font-size: 1.15rem; font-weight: 600; line-height: 1.5; color: var(--text-primary); white-space: pre-line;">
            ${dIsCardFlipped ? card.back : card.front}
          </div>

          ${(!dIsCardFlipped && card.hint) ? `
            <div style="margin-top: 12px; font-size: 0.78rem; color: var(--text-muted);">
              💡 Clue: ${card.hint}
            </div>
          ` : ''}

          <div style="position: absolute; bottom: 10px; font-size: 0.75rem; color: var(--text-muted);">
            🔄 Click card to flip
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px; flex-wrap: wrap; gap: 8px;">
          <div style="display: flex; gap: 8px;">
            <button type="button" class="btn btn-secondary btn-sm" onclick="prevDetailCard()" ${dCardIndex === 0 ? 'disabled' : ''}>
              ← Previous
            </button>
            <button type="button" class="btn btn-secondary btn-sm" onclick="flipDetailCard()">
              🔄 Flip
            </button>
            <button type="button" class="btn btn-primary btn-sm" onclick="nextDetailCard()" ${dCardIndex === total - 1 ? 'disabled' : ''}>
              Next →
            </button>
          </div>

          <div style="display: flex; gap: 8px;">
            <button type="button" class="btn btn-secondary btn-sm" onclick="shuffleDetailCards()" title="Shuffle flashcards randomly">
              🔀 Shuffle
            </button>
            <button type="button" class="btn ${isCompleted ? 'btn-secondary' : 'btn-success'} btn-sm" onclick="toggleDetailCardCompleted()">
              ${isCompleted ? '↩️ Unmark' : '✅ Mark as Completed'}
            </button>
          </div>
        </div>
      </div>
    `;
  }

  function flipDetailCard() {
    dIsCardFlipped = !dIsCardFlipped;
    renderDetailFlashcardView();
  }

  function nextDetailCard() {
    if (dCardIndex < dFlashcards.length - 1) {
      dCardIndex++;
      dIsCardFlipped = false;
      renderDetailFlashcardView();
    }
  }

  function prevDetailCard() {
    if (dCardIndex > 0) {
      dCardIndex--;
      dIsCardFlipped = false;
      renderDetailFlashcardView();
    }
  }

  function shuffleDetailCards() {
    for (let i = dFlashcards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [dFlashcards[i], dFlashcards[j]] = [dFlashcards[j], dFlashcards[i]];
    }
    dCardIndex = 0;
    dIsCardFlipped = false;
    dCompletedCards.clear();
    renderDetailFlashcardView();
    if (window.showToast) window.showToast('Flashcards shuffled!', 'info');
  }

  function toggleDetailCardCompleted() {
    if (dCompletedCards.has(dCardIndex)) {
      dCompletedCards.delete(dCardIndex);
    } else {
      dCompletedCards.add(dCardIndex);
    }
    renderDetailFlashcardView();
  }

  // MCQs (Requirement 3: Option selection, submit, instant feedback, score calculation, final result)
  function initDetailMcqs() {
    renderDetailMcqs();
  }

  function renderDetailMcqs() {
    const container = document.getElementById('detailMcqContainer');
    if (!container) return;
    const mcqList = dMcqs;
    if (!mcqList || mcqList.length === 0) {
      container.innerHTML = '<p>No practice MCQs available.</p>';
      return;
    }

    const answeredCount = Object.keys(dMcqAnswers).length;
    let score = 0;
    Object.keys(dMcqAnswers).forEach(qIdx => {
      if (dMcqAnswers[qIdx].isCorrect) score++;
    });

    const allAnswered = answeredCount === mcqList.length && mcqList.length > 0;
    const scorePercent = Math.round((score / mcqList.length) * 100);

    container.innerHTML = `
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 10px 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
        <div>
          <strong style="font-size: 0.95rem;">🎯 Practice Quiz Mode</strong>
          <span style="font-size: 0.8rem; color: var(--text-muted); margin-left: 8px;">Select an option for instant validation & feedback</span>
        </div>
        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="font-weight: 700; font-size: 0.9rem; color: var(--accent-primary);">
            Score: ${score} / ${answeredCount} answered (${mcqList.length} total)
          </span>
          <button type="button" class="btn btn-secondary btn-sm" onclick="resetDetailMcqs()" style="padding: 3px 8px; font-size: 0.75rem;">
            🔄 Reset
          </button>
        </div>
      </div>

      ${allAnswered ? `
        <div style="margin-bottom: 18px; padding: 16px 20px; background: #10b98115; border: 2px solid #10b981; border-radius: var(--radius-md); text-align: center;">
          <h3 style="margin: 0 0 6px; font-size: 1.25rem; color: #047857;">🎉 Quiz Completed!</h3>
          <p style="margin: 0 0 10px; font-size: 0.95rem; color: var(--text-primary);">
            Final Score: <strong>${score} / ${mcqList.length} (${scorePercent}%)</strong> • Mastery Level: 
            <span class="nav-badge" style="font-size: 0.8rem; background: #10b981; color: white;">${scorePercent >= 80 ? 'Master' : (scorePercent >= 50 ? 'Proficient' : 'Needs Review')}</span>
          </p>
          <button type="button" class="btn btn-primary btn-sm" onclick="resetDetailMcqs()">Retake Quiz</button>
        </div>
      ` : ''}

      <div style="display: flex; flex-direction: column; gap: 14px;">
        ${mcqList.map((mcq, qIdx) => {
          const ans = dMcqAnswers[qIdx];
          const hasAnswered = ans !== undefined;
          const diffBadge = mcq.difficultyLevel || mcq.difficulty || 'Medium';

          return `
            <div style="padding: 14px; background: var(--bg-primary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; gap: 8px;">
                <strong style="font-size: 0.94rem;">
                  Q${qIdx + 1}: ${mcq.question}
                </strong>
                <div style="display: flex; gap: 6px; align-items: center; flex-shrink: 0;">
                  <span class="unit-number-badge" style="font-size: 0.7rem;">${mcq.relatedTopic || mcq.topic || 'Concept'}</span>
                  <span class="nav-badge" style="font-size: 0.7rem; ${diffBadge === 'Easy' ? 'background: #10b98120; color: #10b981;' : (diffBadge === 'Hard' ? 'background: #ef444420; color: #ef4444;' : 'background: #f59e0b20; color: #f59e0b;')}">${diffBadge}</span>
                </div>
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                ${(mcq.options || []).map((opt, oIdx) => {
                  let optStyle = 'background: var(--bg-surface); border: 1px solid var(--border-color); cursor: pointer;';
                  let icon = '';

                  if (hasAnswered) {
                    optStyle = 'background: var(--bg-surface); border: 1px solid var(--border-color); cursor: default;';
                    if (oIdx === mcq.correctOption) {
                      optStyle = 'background: #10b98120; border: 2px solid #10b981; font-weight: 700; color: #047857;';
                      icon = ' ✅';
                    } else if (ans.selectedOption === oIdx && !ans.isCorrect) {
                      optStyle = 'background: #ef444420; border: 2px solid #ef4444; font-weight: 700; color: #b91c1c;';
                      icon = ' ❌';
                    }
                  }

                  return `
                    <div onclick="selectDetailMcqOption(${qIdx}, ${oIdx})" style="padding: 8px 12px; border-radius: 4px; font-size: 0.86rem; transition: background 0.15s; ${optStyle}">
                      <strong>${String.fromCharCode(65 + oIdx)}.</strong> ${opt} ${icon}
                    </div>
                  `;
                }).join('')}
              </div>

              ${hasAnswered ? `
                <div style="margin-top: 10px; padding: 8px 12px; background: var(--bg-surface); border-radius: 4px; font-size: 0.84rem; line-height: 1.45; border-left: 3px solid ${ans.isCorrect ? '#10b981' : '#f59e0b'};">
                  <strong>${ans.isCorrect ? '🎉 Correct!' : '💡 Explanation:'}</strong> ${mcq.explanation}
                </div>
              ` : ''}
            </div>
          `;
        }).join('')}
      </div>
    `;
  }

  function selectDetailMcqOption(qIdx, oIdx) {
    if (dMcqAnswers[qIdx] !== undefined) return;
    const mcqs = dMcqs;
    const mcq = mcqs[qIdx];
    if (!mcq) return;

    const isCorrect = oIdx === mcq.correctOption;
    dMcqAnswers[qIdx] = { selectedOption: oIdx, isCorrect };
    renderDetailMcqs();
  }

  function resetDetailMcqs() {
    dMcqAnswers = {};
    renderDetailMcqs();
  }

  // Jump to Timestamp & Highlight
  function jumpToDetailTimestamp(ts) {
    const clean = ts.replace(/[\[\]]/g, '').replace(':', '_');
    const target = document.getElementById('line_' + clean);
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.style.background = 'var(--accent-light)';
      target.style.borderLeft = '3px solid var(--accent-primary)';
      setTimeout(() => {
        target.style.background = 'var(--bg-primary)';
        target.style.borderLeft = '3px solid transparent';
      }, 2500);
    }
  }

  function filterTranscriptLines() {
    const q = document.getElementById('transcriptSearchInput').value.toLowerCase();
    document.querySelectorAll('.transcript-line').forEach(el => {
      const txt = el.textContent.toLowerCase();
      el.style.display = txt.includes(q) ? 'block' : 'none';
    });
  }

  // Markdown Export - Exports all 24 Academic Dimensions
  function buildDetailMarkdown() {
    const m = STUDY_PACK_DATA;
    let md = '# ' + TRANSCRIPT_DATA.title + '\n\n';
    md += '**Milestone:** ' + TRANSCRIPT_DATA.topicTitle + ' | **Category:** ' + (TRANSCRIPT_DATA.categoryName || TRANSCRIPT_DATA.categoryId) + '\n\n';
    
    // 1. Lecture Summary
    md += '## 1. Complete Lecture Summary\n' + (m.lectureSummary || m.shortSummary || '') + '\n\n';

    // 2. Topic-wise Notes
    md += '## 2. Topic-wise Notes\n';
    (m.topicWiseNotes || []).forEach((tp, idx) => {
      md += '### 2.' + (idx + 1) + ' ' + tp.title + (tp.timestamp ? ' (' + tp.timestamp + ')' : '') + '\n';
      if (tp.introduction) md += '**Introduction:** ' + tp.introduction + '\n\n';
      if (tp.detailedExplanation || tp.simpleExplanation) md += '**Detailed Explanation:** ' + (tp.detailedExplanation || tp.simpleExplanation) + '\n\n';
      if (Array.isArray(tp.importantPoints) && tp.importantPoints.length > 0) {
        md += '**Key Points:**\n' + tp.importantPoints.map(p => '- ' + p).join('\n') + '\n\n';
      }
      if (Array.isArray(tp.examples) && tp.examples.length > 0) {
        md += '**Examples:**\n' + tp.examples.map(e => '- ' + e).join('\n') + '\n\n';
      }
      if (Array.isArray(tp.relatedQuestions) && tp.relatedQuestions.length > 0) {
        md += '**Related Questions:**\n' + tp.relatedQuestions.map(q => '- ' + q).join('\n') + '\n\n';
      }
    });

    // 3. Subtopic-wise Notes
    if (Array.isArray(m.subtopicWiseNotes) && m.subtopicWiseNotes.length > 0) {
      md += '## 3. Subtopic-wise Notes\n';
      m.subtopicWiseNotes.forEach(st => {
        md += '### ' + (st.subtopic || st.title || 'Subtopic') + '\n' + (st.explanation || '') + '\n\n';
      });
    }

    // 4. Detailed Topic Explanations
    if (Array.isArray(m.detailedExplanations) && m.detailedExplanations.length > 0) {
      md += '## 4. Detailed Topic Explanations\n';
      m.detailedExplanations.forEach(d => {
        md += '### ' + (d.topic || 'Concept') + '\n' + (d.content || d.explanation || '') + '\n\n';
      });
    }

    // 5. Important Definitions
    if (Array.isArray(m.importantDefinitions) && m.importantDefinitions.length > 0) {
      md += '## 5. Important Definitions\n';
      m.importantDefinitions.forEach(d => {
        md += '- **' + d.term + '**: ' + d.definition + '\n';
      });
      md += '\n';
    }

    // 6. Key Concepts
    if (Array.isArray(m.keyConcepts) && m.keyConcepts.length > 0) {
      md += '## 6. Key Concepts\n';
      m.keyConcepts.forEach(c => {
        md += '### ' + c.concept + '\n' + c.explanation + '\n\n';
      });
    }

    // 7. Important Points
    if (Array.isArray(m.importantPoints) && m.importantPoints.length > 0) {
      md += '## 7. Important Points\n';
      m.importantPoints.forEach(p => {
        md += '- ' + p + '\n';
      });
      md += '\n';
    }

    // 8. Real-world Examples
    if (Array.isArray(m.realWorldExamples) && m.realWorldExamples.length > 0) {
      md += '## 8. Real-world Examples\n';
      m.realWorldExamples.forEach(r => {
        md += '### ' + r.title + '\n**Scenario:** ' + (r.scenario || '') + '\n\n**Application:** ' + (r.application || '') + '\n\n';
      });
    }

    // 9. Solved Examples
    const solved = m.solvedExamples || m.examples || [];
    if (Array.isArray(solved) && solved.length > 0) {
      md += '## 9. Solved Examples\n';
      solved.forEach((s, idx) => {
        md += '### Problem ' + (idx + 1) + ': ' + (s.problem || s.question || '') + '\n';
        md += '**Solution:** ' + (s.solution || s.answer || '') + '\n\n';
      });
    }

    // 10. Important Formulas
    if (Array.isArray(m.importantFormulas) && m.importantFormulas.length > 0) {
      md += '## 10. Important Formulas & Equations\n';
      m.importantFormulas.forEach(f => {
        md += '- **' + (f.name || 'Formula') + '**: `' + (f.formula || '') + '` — ' + (f.description || '') + '\n';
      });
      md += '\n';
    }

    // 11. Flashcards
    if (Array.isArray(m.flashcards) && m.flashcards.length > 0) {
      md += '## 11. Active Recall Flashcards\n';
      m.flashcards.forEach((c, idx) => {
        md += '### Card ' + (idx + 1) + ' [' + (c.difficultyLevel || 'Medium') + '] (' + (c.topic || '') + ')\n';
        md += '**Front:** ' + (c.front || c.question || '') + '\n\n';
        md += '**Back:** ' + (c.back || c.answer || '') + '\n\n';
      });
    }

    // 12. MCQs
    if (Array.isArray(m.practiceMcqs) && m.practiceMcqs.length > 0) {
      md += '## 12. Practice MCQs with Explanations\n';
      m.practiceMcqs.forEach((q, idx) => {
        md += '### Q' + (idx + 1) + ': ' + q.question + ' [' + (q.difficultyLevel || 'Medium') + ']\n';
        (q.options || []).forEach((opt, oIdx) => {
          md += '- ' + String.fromCharCode(65 + oIdx) + '. ' + opt + '\n';
        });
        const correctChar = String.fromCharCode(65 + (typeof q.correctOption === 'number' ? q.correctOption : 0));
        md += '\n**Correct Answer:** Option ' + correctChar + '\n';
        md += '**Explanation:** ' + (q.explanation || '') + '\n\n';
      });
    }

    // 15-18. Exam & Viva Questions
    if (Array.isArray(m.shortAnswerQuestions) && m.shortAnswerQuestions.length > 0) {
      md += '## 15. Short Answer Questions\n';
      m.shortAnswerQuestions.forEach((q, idx) => {
        md += '### Q' + (idx + 1) + ': ' + (q.question || q) + '\n**Model Answer:** ' + (q.modelAnswer || q.answer || '') + '\n\n';
      });
    }
    if (Array.isArray(m.longAnswerQuestions) && m.longAnswerQuestions.length > 0) {
      md += '## 16. Long Answer Questions\n';
      m.longAnswerQuestions.forEach((q, idx) => {
        md += '### Q' + (idx + 1) + ': ' + (q.question || q) + '\n**Comprehensive Answer:** ' + (q.modelAnswer || q.answer || '') + '\n\n';
      });
    }
    if (Array.isArray(m.interviewQuestions) && m.interviewQuestions.length > 0) {
      md += '## 17. Technical Interview Questions\n';
      m.interviewQuestions.forEach((q, idx) => {
        md += '### Q' + (idx + 1) + ': ' + (q.question || q) + '\n**Ideal Response:** ' + (q.answer || '') + '\n\n';
      });
    }
    if (Array.isArray(m.vivaQuestions) && m.vivaQuestions.length > 0) {
      md += '## 18. Laboratory Viva Questions\n';
      m.vivaQuestions.forEach((q, idx) => {
        md += '### Q' + (idx + 1) + ': ' + (q.question || q) + '\n**Concise Answer:** ' + (q.answer || '') + '\n\n';
      });
    }

    // 19. Previous Year Questions
    if (Array.isArray(m.previousYearQuestions) && m.previousYearQuestions.length > 0) {
      md += '## 19. Previous Year University Questions\n';
      m.previousYearQuestions.forEach(p => {
        md += '- **[' + (p.marks || 5) + ' Marks - ' + (p.frequency || 'Frequent') + ']** ' + (p.question || p) + '\n';
      });
      md += '\n';
    }

    // 21. FAQs
    if (Array.isArray(m.faqs) && m.faqs.length > 0) {
      md += '## 21. Frequently Asked Questions\n';
      m.faqs.forEach(f => {
        md += '### ' + (f.question || '') + '\n' + (f.answer || '') + '\n\n';
      });
    }

    // 22. Exam-Oriented Notes
    if (Array.isArray(m.examOrientedNotes) && m.examOrientedNotes.length > 0) {
      md += '## 22. Exam-Oriented Notes\n';
      m.examOrientedNotes.forEach(en => {
        md += '- ' + en + '\n';
      });
      md += '\n';
    }

    // 23. Quick Revision Notes
    if (Array.isArray(m.quickRevisionNotes) && m.quickRevisionNotes.length > 0) {
      md += '## 23. Quick Revision Notes\n';
      m.quickRevisionNotes.forEach(r => {
        md += '- ' + r + '\n';
      });
      md += '\n';
    }

    // 24. Practice Tests
    if (Array.isArray(m.practiceTests) && m.practiceTests.length > 0) {
      md += '## 24. Practice Tests\n';
      m.practiceTests.forEach((t, idx) => {
        md += '### Test ' + (idx + 1) + ': ' + (t.title || 'Practice Set') + ' (' + (t.duration || '30 mins') + ')\n';
        if (Array.isArray(t.questions)) {
          t.questions.forEach((q, qIdx) => {
            md += (qIdx + 1) + '. ' + q + '\n';
          });
        }
        md += '\n';
      });
    }

    return md;
  }

  function exportDetailMarkdown() {
    const md = buildDetailMarkdown();
    const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = (TRANSCRIPT_DATA.topicTitle || 'study-notes') + '.md';
    a.click();
    URL.revokeObjectURL(url);
  }

  function copyDetailMarkdown() {
    const md = buildDetailMarkdown();
    navigator.clipboard.writeText(md).then(() => {
      if (window.showToast) window.showToast('Complete study notes copied to clipboard!', 'success');
      else alert('Notes copied to clipboard!');
    });
  }

  // Rename modal
  function openRenameModal() { document.getElementById('renameModal').classList.remove('hidden'); }
  function closeRenameModal() { document.getElementById('renameModal').classList.add('hidden'); }

  document.getElementById('renameModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeRenameModal();
  });

  async function saveRename(id) {
    const title = document.getElementById('renameTitleInput').value.trim();
    if (!title) return alert('Title cannot be empty');

    try {
      const res = await fetch('/transcription/api/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title })
      });
      const data = await res.json();
      if (data.success) {
        if (window.showToast) window.showToast('Title updated successfully!', 'success');
        window.location.reload();
      } else {
        alert(data.error || 'Failed to update title');
      }
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }

  async function deleteTranscriptFromDetail(id) {
    const confirmed = await window.showConfirmDialog({
      title: 'Delete Lecture Transcript',
      message: 'Are you sure you want to permanently delete this lecture transcript and all generated academic study notes?',
      confirmText: 'Confirm Delete',
      confirmClass: 'btn-danger'
    });
    if (!confirmed) return;

    try {
      let res = await fetch('/transcription/api/' + id, { method: 'DELETE' });
      if (!res.ok) res = await fetch('/transcription/api/' + id + '/delete', { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        if (window.showToast) window.showToast('Transcript deleted.', 'success');
        setTimeout(() => {
          <% if (transcript.categoryType === 'explore') { %>
            window.location.href = '/explore/<%= transcript.categoryId %>';
          <% } else { %>
            window.location.href = '/transcription';
          <% } %>
        }, 500);
      } else {
        alert('Delete failed: ' + data.error);
      }
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }
</script>

