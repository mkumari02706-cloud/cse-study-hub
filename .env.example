# Server Configuration
PORT=3000
NODE_ENV=production

# AI Provider Configuration
# Set your Google Gemini API Key to enable AI study material generation:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Fallback: OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# YouTube & Transcription Configuration
# On localhost: YouTube caption scraping works directly via residential IP.
# On cloud hosting (Render/AWS/GCP): YouTube blocks cloud datacenter IPs and requests CAPTCHA.
# Production uses multi-tier caching (in-memory + persistent disk), direct oEmbed metadata,
# YouTube Data API v3 (optional), manual paste, subtitle file upload (.txt, .srt, .vtt),
# and AI Speech-to-Text media upload (MP3, WAV, M4A, MP4, WEBM).
YOUTUBE_API_KEY=

# Optional: External Database Connection (if configuring external MongoDB Atlas)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/csestudyhub?retryWrites=true&w=majority
